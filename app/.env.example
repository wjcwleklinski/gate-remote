# Copy to /etc/gate-remote/gate-remote.env on the Pi (install.sh does this on
# first run). Contains no secrets — the service holds no credentials of its
# own, it only verifies tokens Keycloak signed.

# ─── Keycloak ─────────────────────────────────────────────────────────────────

# Realm URL, in the form https://<keycloak-host>/realms/<realm-name>.
# Must match the `iss` claim in the tokens exactly — no trailing slash, and
# https even though nginx receives plain HTTP, because Cloudflare is what the
# token issuer sees itself as.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/homelab

# Required `aud` claim. Keycloak puts it there via the audience mapper on the
# mobile and cli clients.
KEYCLOAK_AUDIENCE=gate-remote-api

# Realm role the caller must hold. Can also be written <client>:<role> to
# require a client role specifically.
REQUIRED_ROLE=RESIDENT

# ─── GPIO ─────────────────────────────────────────────────────────────────────

# BCM numbering. Pin 17 is physical pin 11.
GPIO_PIN=17

# How long the pin is held — the length of the simulated button press.
# The gate-server prototype used 1.0; raise it if the gate does not respond.
PULSE_SECONDS=0.5

# true  = pin goes HIGH to press the button (matches the ESP32 wiring)
# false = pin is pulled LOW to press
GPIO_ACTIVE_HIGH=true

# Log the pulse instead of touching hardware. For running on a laptop.
GPIO_MOCK=false

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Counters live in the process, so the service must run a single worker.

MIN_INTERVAL_SECONDS=3
MAX_PER_WINDOW=6
WINDOW_SECONDS=60

# ─── Misc ─────────────────────────────────────────────────────────────────────

JWKS_CACHE=/var/lib/gate-remote/jwks.json
LOG_LEVEL=INFO

# gpiozero must not try the legacy RPi.GPIO backend — it cannot drive the
# Pi 5's RP1 chip.
GPIOZERO_PIN_FACTORY=lgpio
